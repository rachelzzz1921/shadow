{
  "name": "shadow-harness",
  "version": "0.4.0",
  "private": true,
  "description": "Shadow parallel-life narrative — Harness corpus (docs + skills)",
  "scripts": {
    "sync-skills": "bash shadow-corpus/skills/sync-cursor-links.sh",
    "tasks": "node shadow-corpus/06-task-progress/scripts/shadow-tasks.js",
    "board": "node shadow-corpus/06-task-progress/scripts/shadow-tasks.js sync && node shadow-corpus/06-task-progress/scripts/shadow-tasks.js board",
    "board:publish": "node shadow-corpus/06-task-progress/scripts/shadow-tasks.js sync && node shadow-corpus/06-task-progress/scripts/build-board-site.mjs",
    "demo:preview": "python3 -m http.server 5199 --directory docs",
    "demo:phaser": "python3 -m http.server 5199 --directory docs",
    "pack:stories": "node shadow-corpus/06-task-progress/scripts/pack-four-stories.mjs",
    "pack:assets": "node shadow-corpus/06-task-progress/scripts/pack-pixel-assets.mjs",
    "dev": "npm run dev --prefix shadow-corpus/archive/demo-v0.2",
    "start": "npm run start --prefix shadow-corpus/archive/demo-v0.2",
    "test": "npm run test --prefix shadow-corpus/archive/demo-v0.2",
    "test:golden": "node -e \"const s=require('./shadow-corpus/fixtures/golden-stories/复读线.json');const e=require('./shadow-corpus/archive/demo-v0.2/lib/evaluator').evaluateStory(s);console.log(JSON.stringify({ok:e.ok,score:e.score,errors:e.errors,warnings:e.warnings},null,2));process.exit(e.ok?0:1)\"",
    "sync:golden-v2": "node shadow-corpus/tooling/scripts/sync-golden-from-v2.mjs --story fuxduxian --dry-run",
    "sync:golden-v2:apply": "node shadow-corpus/tooling/scripts/sync-golden-from-v2.mjs --story fuxduxian --apply",
    "harness:smoke": "node shadow-corpus/tooling/scripts/harness-live-smoke.mjs",
    "harness:smoke:full": "node shadow-corpus/tooling/scripts/harness-live-smoke.mjs --full",
    "sync:visual-layouts": "cp docs/demo-layouts.json shadow-corpus/archive/demo-v0.2/public/visual-layouts.json",
    "sync:era-snippets": "cp docs/demo-era-snippets.json shadow-corpus/archive/demo-v0.2/public/era-snippets.json",
    "install:demo": "npm install --prefix shadow-corpus/archive/demo-v0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
