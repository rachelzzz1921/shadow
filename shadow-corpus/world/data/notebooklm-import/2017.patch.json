      "can_pivot": false,
      "sensitivity": "low",
      "tags": [
        "mood",
        "academic"
      ],
      "scenario": "academic"
    },
    {
      "category": "digital",
      "text": "我和她在《战狼2》的影厅门口因为抢最后一张票认识，竟然真的谈成了对象。",
      "weight": 0.8,
      "can_pivot": true,
