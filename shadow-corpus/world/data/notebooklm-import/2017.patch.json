      "can_pivot": true,
      "sensitivity": "low",
      "tags": [
        "career",
        "ai"
      ],
      "scenario": "career"
    },
    {
      "category": "school",
      "text": "毕业论文关于‘去杠杆’政策对制造业的影响，查了一个星期的财报，写得我想吐。",
      "weight": 0.9,
      "can_pivot": false,
